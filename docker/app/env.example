# Copy to .env beside docker-compose.app.yml and replace the examples.
APP_IMAGE=bibliotheca-app:latest
PUBLIC_URL=https://books.example.org
TLS_MODE=proxy
# Required in proxy mode: actual connecting proxy IP(s) or dedicated network CIDR(s).
# Do not trust all networks. This is an example, not your deployment's address.
TRUSTED_PROXIES=172.30.0.2
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443
OIDC_SIGNING_PASSWORD_FILE=./secrets/oidc-signing-password
OIDC_ENCRYPTION_PASSWORD_FILE=./secrets/oidc-encryption-password
DATA_PATH=./data
TEMP_PATH=./temp
CERT_PATH=./cert
APPSETTINGS_PATH=./appsettings.json
# Direct TLS mode uses PEM files mounted under CERT_PATH/tls.
TLS_CERTIFICATE=/app/cert/tls/fullchain.pem
TLS_CERTIFICATE_KEY=/app/cert/tls/privkey.pem
MAX_UPLOAD_SIZE=25m
APP_SHM_SIZE=512mb
