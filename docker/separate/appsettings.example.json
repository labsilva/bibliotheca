{
  "AllowedHosts": "api.example.org",
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://0.0.0.0:5500" } } },
  "Authentication": {
    "Issuer": "https://api.example.org/",
    "FrontendOrigin": "https://books.example.org",
    "KnownProxies": ["172.30.0.2"],
    "DataProtectionKeyPath": "/app/data/keys",
    "SigningCertificate": { "Path": "/app/cert/signing.pfx", "Password": "REPLACE" },
    "EncryptionCertificate": { "Path": "/app/cert/encryption.pfx", "Password": "REPLACE" }
  },
  "Authorization": { "AdministratorUserIds": [], "CatalogueManagerUserIds": [] },
  "ExternalEditionSearch": { "Providers": { "wook": { "Enabled": true, "TimeoutSeconds": 15 } } },
  "Fetchers": { "SaveTempFiles": false }
}
