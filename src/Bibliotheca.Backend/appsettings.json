{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "LABSoft": "Trace"
    }
  },
  "AllowedHosts": "*",
  "CoverCache": {
    "MaxAgeSeconds": 86400
  },
  "Playwright": {
    "Remote": null
  },
  "Fetchers": {
    "SaveTempFiles": false,
    "TempFilesSaveLocation": "data/fetcher-diagnostics/"
  },
  "ConnectionStrings": {
    "SQLiteDefault": "Data Source=wwwroot/data/Bibliotheca.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5500"
      },
      "Https": {
        "Url": "https://localhost:5501"
      }
    }
  }
}
